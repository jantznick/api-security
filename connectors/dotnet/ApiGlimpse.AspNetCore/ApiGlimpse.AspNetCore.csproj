<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ApiGlimpse.AspNetCore</RootNamespace>
    <AssemblyName>ApiGlimpse.AspNetCore</AssemblyName>
    <Description>ASP.NET Core middleware that samples traffic and POSTs envelope v1 to the API Glimpse hosted agent.</Description>
    <PackageId>ApiGlimpse.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>API Glimpse</Authors>
    <PackageTags>apiglimpse;middleware;aspnetcore;observability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
