# Core API origin (no trailing slash).
# For marketing → app session handoff locally, point BOTH apps at the API host
# (not the Vite proxy), e.g. http://localhost:3001 — cookie is host-scoped on the API.
# Leave empty only if you are not testing cross-origin auth (proxy /api → :3001).
VITE_API_URL=""

# Marketing origin — app redirects /login /register and unauth users here.
# Local: http://localhost:5174
# Production: https://apiglimpse.com
VITE_MARKETING_URL="http://localhost:5174"

# This app's public origin (used in redirect= query params).
# Local: http://localhost:5173
# Production: https://app.apiglimpse.com
VITE_APP_URL="http://localhost:5173"

VITE_DOCS_URL="http://localhost:5175"
# Production: VITE_DOCS_URL=https://docs.apiglimpse.com

# Production build example:
# VITE_API_URL=https://api.apiglimpse.com
# VITE_MARKETING_URL=https://apiglimpse.com
# VITE_APP_URL=https://app.apiglimpse.com
# VITE_DOCS_URL=https://docs.apiglimpse.com
