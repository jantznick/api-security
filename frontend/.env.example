# Core API origin (no trailing slash).
#
# Minimal local (dashboard only): leave empty → Vite proxy `/api` → :3001.
# Cookie stays on :5173; AuthModal works on the app host.
#
# Cross-origin auth (marketing :5174 ↔ app :5173): set BOTH apps to the API host
# so the session cookie is shared on localhost:3001:
#   VITE_API_URL=http://localhost:3001
VITE_API_URL=

# Marketing origin — product site links from the welcome page.
# Vite `dev` defaults to http://localhost:5174 if unset.
VITE_MARKETING_URL=http://localhost:5174

# This app's public origin (redirect= query params).
# Vite `dev` defaults to the current origin if unset.
VITE_APP_URL=http://localhost:5173

# Docs (header link). Vite `dev` defaults to http://localhost:5175 if unset.
VITE_DOCS_URL=http://localhost:5175

# Hosted collector (install snippet on project settings).
# Vite `dev` defaults to http://localhost:8080 if unset.
VITE_COLLECT_URL=http://localhost:8080

# Acme sales demo (optional — quick links on Topology page after Railway deploy)
# VITE_ACME_DEMO_STOREFRONT_URL=https://storefront-api-xxxx.up.railway.app
# VITE_ACME_DEMO_WEB_URL=https://web-storefront-xxxx.up.railway.app
# VITE_ACME_DEMO_PROJECT_ID=<uuid-acme-demo-project>

# Production build example:
# VITE_API_URL=https://api.apiglimpse.com
# VITE_MARKETING_URL=https://apiglimpse.com
# VITE_APP_URL=https://app.apiglimpse.com
# VITE_DOCS_URL=https://docs.apiglimpse.com
# VITE_COLLECT_URL=https://collect.apiglimpse.com
