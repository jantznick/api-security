# Railway env template — api-glimpse-acme-demo project
# One Railway service per block; rename service to match hostname (ledger-api, etc.)
# See docs/RAILWAY_ACME_DEMO.md

# ── ledger-api (NO public domain) ─────────────────────────
PORT=4014
NODE_ENV=production
API_SENSOR_AGENT_URL=https://collect.apiglimpse.com
API_SENSOR_KEY=ask_ledger_replace_me
API_SENSOR_SERVICE_NAME=ledger-api

# ── fulfillment-api (NO public domain) ───────────────────
# PORT=4013
# API_SENSOR_AGENT_URL=https://collect.apiglimpse.com
# API_SENSOR_KEY=ask_fulfillment_replace_me
# API_SENSOR_SERVICE_NAME=fulfillment-api
# LEDGER_URL=http://ledger-api.railway.internal:4014

# ── commerce-api (NO public domain) ──────────────────────
# PORT=4012
# API_SENSOR_AGENT_URL=https://collect.apiglimpse.com
# API_SENSOR_KEY=ask_commerce_replace_me
# API_SENSOR_SERVICE_NAME=commerce-api
# FULFILLMENT_URL=http://fulfillment-api.railway.internal:4013

# ── storefront-api (PUBLIC domain required) ──────────────
# PORT=4011
# API_SENSOR_AGENT_URL=https://collect.apiglimpse.com
# API_SENSOR_KEY=ask_storefront_replace_me
# API_SENSOR_SERVICE_NAME=storefront-api
# COMMERCE_URL=http://commerce-api.railway.internal:4012

# ── web-storefront (PUBLIC optional) ─────────────────────
# PORT=4010
# API_SENSOR_AGENT_URL=https://collect.apiglimpse.com
# API_SENSOR_KEY=ask_web_storefront_replace_me
# API_SENSOR_SERVICE_NAME=web-storefront
# STOREFRONT_API_URL=http://storefront-api.railway.internal:4011

# ── Smoke / traffic (laptop — not Railway vars) ──────────
# STOREFRONT_URL=https://storefront-api-xxxx.up.railway.app
