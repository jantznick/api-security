DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_security?schema=public"
SESSION_SECRET="change-this-in-development"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
# Production: FRONTEND_URL=https://<dashboard>.onrender.com (Render origin for CORS)
# Leave COOKIE_DOMAIN unset when dashboard (Render) and API (Railway) are on different registrable domains.
# COOKIE_DOMAIN=
# Optional: magic-link email via Resend (dev logs tokens to console if unset)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="API Glimpse <onboarding@resend.dev>"
# later: RESEND_FROM_EMAIL="API Glimpse <noreply@apiglimpse.com>"
# ADMIN_EMAIL=you@example.com
