DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_security?schema=public"
SESSION_SECRET="change-this-in-development"
PORT=3001
NODE_ENV=development

# CORS allowlist — comma-separated origins (preferred when app + marketing both call the API)
# Local: app Vite :5173 + marketing Vite :5174
FRONTEND_URLS="http://localhost:5173,http://localhost:5174"
# Or set individually (used when FRONTEND_URLS is unset):
# FRONTEND_URL="http://localhost:5173"
# MARKETING_URL="http://localhost:5174"

# Magic-link emails use MARKETING_URL (falls back to FRONTEND_URL)
MARKETING_URL="http://localhost:5174"

# Production (custom domains on apiglimpse.com):
# FRONTEND_URLS="https://app.apiglimpse.com,https://apiglimpse.com,https://www.apiglimpse.com"
# MARKETING_URL="https://apiglimpse.com"
# COOKIE_DOMAIN=.apiglimpse.com
# Leave COOKIE_DOMAIN unset when dashboard and API are on different registrable domains
# (e.g. Render *.onrender.com → Railway *.up.railway.app).
# COOKIE_DOMAIN=

# Optional: magic-link email via Resend (dev logs tokens to console if unset)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="API Glimpse <onboarding@resend.dev>"
# later: RESEND_FROM_EMAIL="API Glimpse <noreply@apiglimpse.com>"
# ADMIN_EMAIL=you@example.com
