generator client {
  provider = "prisma-client-js"
}

// Second output so ingest can `import '@prisma/client'` from its own node_modules.
// Default generate lands under backend/; ingest shares this schema file.
generator ingestClient {
  provider = "prisma-client-js"
  output   = "../../ingest/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  owner
  admin
  member
  viewer
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  password             String?
  /// Optional public display name (not unique)
  displayName          String?
  /// Stripe Customer id (cus_…); set on first Checkout
  stripeCustomerId     String?      @unique
  /// Active subscription id (sub_…) when subscribed
  stripeSubscriptionId String?
  /// Matches Plan.slug — free | pro | …
  planSlug             String       @default("free")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  memberships          Membership[]
  orgInvitesSent       OrgInvite[]  @relation("OrgInviteInviter")

  @@index([planSlug])
}

model Plan {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  /// Short blurb for pricing / billing UI
  description       String?
  /// Cap applied to each of the user's services on plan change. null = unlimited.
  endpointLimit     Int?
  /// Max org members including owner. null = unlimited. Free = 3 (D11).
  seatLimit         Int?
  priceCentsMonthly Int      @default(0)
  /// Stripe Price id (price_…) for Checkout; null for free / unpaid / contact-sales plans
  stripePriceId     String?
  /// When true, Checkout is disabled — CTA opens the contact-sales form (leads in Admin)
  contactSales      Boolean  @default(false)
  /// Optional external URL override; when set, can still deep-link instead of the in-app form
  contactUrl        String?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Contact-sales inquiries (Enterprise, etc.) — simple lead inbox for Admin
model ContactLead {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String?
  /// Plan they inquired about (e.g. enterprise)
  planSlug  String?
  /// Set when the submitter was logged in
  userId    String?
  /// marketing | billing | other
  source    String   @default("billing")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([planSlug])
}

model MagicToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Session {
  sid    String   @id
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model Organization {
  id                   String              @id @default(uuid())
  name                 String
  slug                 String              @unique
  /// Personal orgs are 1:1 with a user; always created on signup
  isPersonal           Boolean             @default(false)
  /// Copied from User for future S5 org billing; User.stripe* remains source of truth until then
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?
  planSlug             String              @default("free")
  /// Snapshotted from Plan on assign. null = unlimited. Template edits do not cascade.
  endpointLimit        Int?
  /// Snapshotted seat cap including owner. null = unlimited.
  seatLimit            Int?
  /// When planSlug + limits were last applied to this org
  planAssignedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  memberships          Membership[]
  projects             Project[]
  invites              OrgInvite[]
  roleDefinitions      OrgRoleDefinition[]

  @@index([planSlug])
}

/// Built-in system roles are global templates (organizationId = null, isSystem = true).
/// Custom roles are per-org rows (organizationId set, isSystem = false).
model OrgRoleDefinition {
  id             String        @id @default(uuid())
  /// null = global system template (owner/admin/member/viewer)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Stable slug: owner|admin|member|viewer or org-unique custom key
  key            String
  name           String
  description    String?
  isSystem       Boolean       @default(false)
  /// Permission flags as Json string array (see backend/lib/permissions.js)
  permissions    Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  memberships    Membership[]
  invites        OrgInvite[]

  @@index([organizationId])
}

model Membership {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// System role when customRoleId is null. Kept for owner special-casing + migration.
  role           OrgRole            @default(member)
  /// When set, effective permissions come from this custom role (role enum unused for authz).
  customRoleId   String?
  customRole     OrgRoleDefinition? @relation(fields: [customRoleId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([customRoleId])
}

model OrgInvite {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  /// System role when customRoleId is null
  role           OrgRole            @default(member)
  customRoleId   String?
  customRole     OrgRoleDefinition? @relation(fields: [customRoleId], references: [id], onDelete: Restrict)
  tokenHash      String             @unique
  invitedById    String
  invitedBy      User               @relation("OrgInviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime           @default(now())

  @@index([organizationId, email])
  @@index([customRoleId])
}

/// Named grouping of related services (e.g. "Payments"). Not today's inventory unit.
model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Optional outbound webhook for inventory drift events (SF2).
  webhookUrl     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  services       Service[]

  @@index([organizationId])
}

/// One middleware-connected API (today's Project). Keys + endpoints live here.
model Service {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  /// Cap on *new* endpoints for this service. null or 0 = unlimited (or fall back to env ENDPOINT_LIMIT at ingest).
  endpointLimit Int?
  /// Optional outbound webhook for inventory drift events (SF2). Overrides Project.webhookUrl when set.
  webhookUrl    String?
  /// Protect MVP (SF7): dashboard toggle; connectors poll policy via agent.
  protectEnabled Boolean  @default(false)
  /// observe | block (fail-open). Only meaningful when protectEnabled.
  protectMode   String    @default("observe")
  /// Single MVP rule id, e.g. "deny_unauth_sensitive"
  protectRule   String?
  /// Bumped when protect settings change so connectors can detect refresh.
  protectVersion Int      @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  apiKeys       ApiKey[]
  endpoints     Endpoint[]
  events        InventoryEvent[]
  trafficEdges  TrafficEdge[]

  @@index([projectId])
}

model ApiKey {
  id         String    @id @default(uuid())
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name       String    @default("default")
  /// SHA-256 hex of the full API key (key never stored plaintext)
  keyHash    String    @unique
  /// First 8 chars for display, e.g. "ask_abcd..."
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  /// Soft revoke — key hash retained; ingest rejects when set
  revokedAt  DateTime?

  @@index([serviceId])
}

model Endpoint {
  id             String   @id @default(uuid())
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  method         String
  pathTemplate   String
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  hitCount       Int      @default(0)
  /// Observed auth modes: bearer, cookie, none (JSON array)
  authModes      Json     @default("[]")
  /// Status code histogram: { "200": 12, "404": 1 }
  statusCodes    Json     @default("{}")
  /// Merged request body schema fragment (JSON Schema-ish)
  requestSchema  Json?
  /// Merged response body schema fragment
  responseSchema Json?
  /// Request/response content types seen
  contentTypes   Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  signals        Signal[]
  events         InventoryEvent[]

  @@unique([serviceId, method, pathTemplate])
  @@index([serviceId])
  @@index([lastSeenAt])
}

model Signal {
  id         String   @id @default(uuid())
  endpointId String
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  /// e.g. sensitive_field, auth_observed
  type       String
  /// JSON path or field name, e.g. "body.email", "header.authorization"
  fieldPath  String
  /// email | phone | ssn | jwt | card | password | secret | ...
  category   String
  severity   String   @default("info")
  lastSeenAt DateTime @default(now())
  metadata   Json?

  @@unique([endpointId, type, fieldPath, category])
  @@index([endpointId])
}


/// Drift / change alerts from inventory upserts (SF2).
model InventoryEvent {
  id         String    @id @default(uuid())
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  endpointId String?
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  /// endpoint.discovered | signal.appeared | auth.regressed
  type       String
  payload    Json      @default("{}")
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([serviceId, createdAt])
  @@index([serviceId, readAt])
  @@index([endpointId])
  @@index([type])
}

/// Caller → endpoint edges for topology (SF3).
model TrafficEdge {
  id           String   @id @default(uuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  callerKey    String
  callerLabel  String
  method       String
  pathTemplate String
  hitCount     Int      @default(0)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([serviceId, callerKey, method, pathTemplate])
  @@index([serviceId])
  @@index([lastSeenAt])
}
