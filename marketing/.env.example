# Local development (copy to .env)
VITE_APP_URL=http://localhost:5173
VITE_DOCS_URL=http://localhost:5175

# Core API origin (no trailing slash).
# Minimal: leave empty → Vite proxy `/api` → :3001 (session cookie on :5174 only).
# Cross-origin handoff to the dashboard: set BOTH marketing + frontend to:
#   VITE_API_URL=http://localhost:3001
VITE_API_URL=

# Production build example:
# VITE_APP_URL=https://app.apiglimpse.com
# VITE_DOCS_URL=https://docs.apiglimpse.com
# VITE_API_URL=https://api.apiglimpse.com

# Optional — collect endpoint URL if referenced at build time
# VITE_COLLECT_URL=https://collect.apiglimpse.com
