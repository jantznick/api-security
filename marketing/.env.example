# Build-time URLs (Vite inlines VITE_* at build)
VITE_APP_URL=https://app.apiglimpse.com
VITE_DOCS_URL=https://docs.apiglimpse.com

# Core API origin (no trailing slash).
# Local cross-origin auth: set to http://localhost:3001 (same as frontend) so the
# session cookie is shared. Empty uses Vite proxy (/api → :3001) on :5174 only.
VITE_API_URL=

# Local development example:
# VITE_APP_URL=http://localhost:5173
# VITE_API_URL=http://localhost:3001
# Marketing runs on :5174 (see vite.config.js)

# Optional — collect endpoint URL if referenced at build time
# VITE_COLLECT_URL=https://collect.apiglimpse.com
