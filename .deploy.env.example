# Copy to .deploy.env (gitignored) before first Railway deploy if apiglimpse.com DNS
# is not wired yet. Used for core CORS (FRONTEND_URLS / MARKETING_URL).
#
# Find URLs in Render → each static site → Settings → URL.

RENDER_DASHBOARD_URL=https://your-dashboard.onrender.com
RENDER_MARKETING_URL=https://your-marketing.onrender.com

# Optional overrides (normally generated by scripts/deploy-railway.sh):
# RAILWAY_SESSION_SECRET=
# RAILWAY_FRONTEND_URLS=https://your-dashboard.onrender.com,https://your-marketing.onrender.com
# RAILWAY_MARKETING_URL=https://your-marketing.onrender.com
