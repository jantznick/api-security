{
  "name": "@apiglimpse/nestjs",
  "version": "0.1.0",
  "description": "NestJS module that sends API traffic metadata to API Glimpse (reuses Express / Fastify connectors)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "nest",
    "middleware",
    "api-security",
    "discovery",
    "observability",
    "apiglimpse"
  ],
  "homepage": "https://github.com/jantznick/api-security/tree/main/packages/nestjs",
  "bugs": {
    "url": "https://github.com/jantznick/api-security/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jantznick/api-security.git",
    "directory": "packages/nestjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "publish:npm": "node ./scripts/publish.mjs",
    "test": "npm run build && tsx --tsconfig tsconfig.test.json --test test/**/*.test.ts"
  },
  "dependencies": {
    "@apiglimpse/fastify": "file:../fastify",
    "@apiglimpse/middleware": "file:../middleware"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": ">=0.1.12",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-fastify": "^11.1.24",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "express": "^4.22.2",
    "fastify": "^4.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
